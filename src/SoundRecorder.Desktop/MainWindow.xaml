<Window x:Class="SoundRecorder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoundRecorder.Desktop"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Sound Recorder" Width="980" Height="720" MinWidth="760" MinHeight="560"
        automation:AutomationProperties.ItemStatus="{Binding InitializationCompleted}"
        Style="{DynamicResource RecorderWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/RecorderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
            <local:RecordingFileNameConverter x:Key="RecordingName"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Padding="24,12" Style="{StaticResource WorkspaceHeader}">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Sound Recorder" FontSize="17" FontWeight="SemiBold"
                           Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                <Button x:Name="ModelsButton" DockPanel.Dock="Right" Content="{Binding ModelHeaderButtonText}"
                        Command="{Binding ShowModelsCommand}" Style="{StaticResource HeaderButton}"
                        automation:AutomationProperties.Name="{Binding ModelHeaderButtonText}" Margin="0" Padding="12,6"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="LibraryPane" Padding="18,20" Style="{StaticResource WorkspaceSidebar}"
                    automation:AutomationProperties.Name="Recording library">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Meetings" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <Label Target="{Binding ElementName=LibrarySearchBox}" Content="Search meetings"/>
                        <TextBox x:Name="LibrarySearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Search meetings" Margin="0,0,0,14"/>
                        <Button Content="View transcription jobs" Command="{Binding ShowJobsCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                        <TextBlock x:Name="LibraryMessageText" Text="{Binding LibraryMessage}" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                    </StackPanel>
                    <ListBox x:Name="HistoryList" ItemsSource="{Binding FilteredRecordings}"
                             SelectedItem="{Binding SelectedRecording, Mode=OneWay}"
                             SelectionChanged="HistoryList_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             automation:AutomationProperties.Name="Local recording history">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,12" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Converter={StaticResource RecordingName}}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Language}" Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding CapturedDuration}" Style="{StaticResource HelperText}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border x:Name="ReaderPane" Grid.Column="1" Padding="24,20"
                    automation:AutomationProperties.Name="Transcript reader">
                <Grid>
                    <Grid Visibility="{Binding IsLibraryView, Converter={StaticResource VisibleWhen}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding SelectedRecordingTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedRecordingInformation}" Style="{StaticResource HelperText}" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="Open output folder" Click="OpenOutputFolder_Click"/>
                                <Button Content="Copy transcript" Click="CopyTranscript_Click" IsEnabled="{Binding CanCopyTranscript}"/>
                                <Button Content="Transcribe again" Command="{Binding RetranscribeSelectedRecordingCommand}"
                                        IsEnabled="{Binding CanRetranscribeSelectedRecording}"/>
                                <Button x:Name="DeleteRecordingButton" Content="Delete recording..." Click="DeleteRecording_Click"
                                        IsEnabled="{Binding CanDeleteRecording}"/>
                                <Button Content="Retry deletion" Command="{Binding RetryRecordingDeletionCommand}"
                                        IsEnabled="{Binding CanDeleteRecording}"
                                        Visibility="{Binding HasPendingDeletion, Converter={StaticResource VisibleWhen}}"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Grid.Row="1" Padding="0,0,0,16"
                                Visibility="{Binding HasPlayableRecording, Converter={StaticResource VisibleWhen}}"
                                automation:AutomationProperties.Name="Recording playback">
                            <StackPanel>
                                <TextBlock Text="Listen while you read" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" x:Name="PlayRecordingButton" Content="Play"
                                            automation:AutomationProperties.HelpText="{Binding PlaybackSourcePath}"
                                            Command="{Binding PlayRecordingCommand}" automation:AutomationProperties.Name="Play recording"/>
                                    <Button DockPanel.Dock="Left" x:Name="PausePlaybackButton" Content="Pause audio"
                                                    Command="{Binding PausePlaybackCommand}" IsEnabled="{Binding IsPlaying}"
                                                    automation:AutomationProperties.Name="Pause recording playback"/>
                                    <Slider x:Name="PlaybackPositionSlider" Minimum="0"
                                            Maximum="{Binding PlaybackDurationSeconds}" Value="{Binding PlaybackPositionSeconds}"
                                            VerticalAlignment="Center" automation:AutomationProperties.Name="Playback position"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <ScrollViewer x:Name="TranscriptScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      automation:AutomationProperties.Name="Completed transcript">
                            <StackPanel>
                                <TextBlock Text="{Binding TranscriptReviewLabel}" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                                <StackPanel Margin="0,0,0,12"
                                            Visibility="{Binding SelectedRecordingJobProgress.HasActiveProgress, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                                    <TextBlock x:Name="RecordingJobProgressText" Text="{Binding SelectedRecordingJobProgress.ProgressText}"
                                               Style="{StaticResource HelperText}"/>
                                    <ProgressBar x:Name="RecordingJobProgress" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding SelectedRecordingJobProgress.ProgressPercent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding SelectedRecordingJobProgress.IsProgressIndeterminate}"
                                                 automation:AutomationProperties.Name="Current recording transcription progress"/>
                                </StackPanel>
                                <TextBox x:Name="TranscriptText" Text="{Binding Transcript, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" BorderThickness="0" Padding="0"
                                         AcceptsReturn="True" Background="Transparent"
                                         FontSize="15" VerticalAlignment="Top"
                                         automation:AutomationProperties.Name="Transcript text"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer x:Name="ModelSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsModelsView, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <Button Content="Back to meeting" Command="{Binding ShowLibraryCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,16"/>
                            <TextBlock Text="Local transcription models" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
                            <TextBlock x:Name="ModelStatusText" Text="{Binding ModelStatus}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <Label Target="{Binding ElementName=DownloadedModelSelector}" Content="Downloaded models"/>
                            <ComboBox x:Name="DownloadedModelSelector" ItemsSource="{Binding DownloadedModels}"
                                      IsEnabled="{Binding IsModelSelectorEnabled}"
                                      SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName"
                                      automation:AutomationProperties.Name="Downloaded models"/>
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="{Binding ModelDownloadStatus}" Style="{StaticResource HelperText}"/>
                                <ProgressBar x:Name="ModelDownloadProgress" Minimum="0" Maximum="100" Height="6" Margin="0,8"
                                             Value="{Binding ModelDownloadPercent, Mode=OneWay}" IsIndeterminate="{Binding IsModelDownloadIndeterminate}"
                                             Visibility="{Binding IsDownloadingModel, Converter={StaticResource VisibleWhen}}"
                                             automation:AutomationProperties.Name="Model download progress"
                                             automation:AutomationProperties.ItemStatus="{Binding ModelDownloadAccessibilityState}"/>
                                <Button Content="Cancel download" Command="{Binding CancelModelDownloadCommand}" HorizontalAlignment="Left"
                                        Visibility="{Binding IsDownloadingModel, Converter={StaticResource VisibleWhen}}"/>
                            </StackPanel>
                            <Expander x:Name="ModelCatalogExpander" Header="Download other models" Margin="0,16,0,0">
                                <StackPanel Margin="0,12,0,0">
                                    <Label Target="{Binding ElementName=ModelCatalogFilter}" Content="Catalog language support"/>
                                    <ComboBox x:Name="ModelCatalogFilter" ItemsSource="{Binding ModelCatalogFilters}"
                                              SelectedItem="{Binding ModelCatalogFilter}"
                                              automation:AutomationProperties.Name="Catalog language support"/>
                                    <TextBlock Text="Twelve model families, each with six separate downloadable encodings. English-only models cannot transcribe Brazilian Portuguese."
                                               Style="{StaticResource HelperText}" Margin="0,12"/>
                                    <ItemsControl x:Name="ModelCatalogList" ItemsSource="{Binding CatalogFamilies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" Padding="0,12"
                                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Family}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Languages}" Style="{StaticResource HelperText}" Margin="0,4,0,8"/>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="Download" Margin="8,0,0,0"
                                                                    automation:AutomationProperties.Name="{Binding Family, StringFormat=Download {0}}"
                                                                    Command="{Binding DataContext.DownloadCatalogModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding SelectedVariant}"/>
                                                            <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}"
                                                                      automation:AutomationProperties.AutomationId="{Binding Family}"
                                                                      DisplayMemberPath="Encoding" automation:AutomationProperties.Name="Model encoding"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Import a previously downloaded package" Margin="0,16">
                                <Button Content="Import model package..." Click="ImportModel_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <DockPanel Visibility="{Binding IsJobsView, Converter={StaticResource VisibleWhen}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="Back to meeting" Command="{Binding ShowLibraryCommand}" HorizontalAlignment="Left"
                                    Margin="0,0,0,8" MinHeight="24" Padding="0" BorderThickness="0" Background="Transparent"/>
                            <TextBlock Text="Transcription jobs" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Pause is unavailable. Stop/Cancel keep completed outputs; Delete removes only job history."
                                       Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="Cancel" automation:AutomationProperties.Name="Cancel selected job" Command="{Binding CancelJobCommand}"
                                        IsEnabled="{Binding SelectedJobRow.CanCancel, FallbackValue=False}"/>
                                <Button Content="Stop" automation:AutomationProperties.Name="Stop selected job" Command="{Binding StopJobCommand}"
                                        IsEnabled="{Binding SelectedJobRow.CanStop, FallbackValue=False}"/>
                                <Button Content="Restart" automation:AutomationProperties.Name="Restart selected job" Command="{Binding RetryTranscriptionCommand}"
                                        IsEnabled="{Binding CanRestartSelectedJob}"/>
                                <Button Content="Delete job..." automation:AutomationProperties.Name="Delete job history..." Click="DeleteJobHistory_Click"
                                        IsEnabled="{Binding CanDeleteSelectedJob}"/>
                                <Button Content="View transcript" Click="ViewTranscript_Click"
                                        IsEnabled="{Binding SelectedJobRow.CanViewTranscript, FallbackValue=False}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding JobsMessage}" Style="{StaticResource HelperText}"/>
                        </StackPanel>
                        <ListBox x:Name="JobsList" ItemsSource="{Binding JobRows}" SelectedItem="{Binding SelectedJobRow}"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 automation:AutomationProperties.Name="Transcription job status">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Language}" Style="{StaticResource HelperText}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding ModelName}" Style="{StaticResource HelperText}"/>
                                        </WrapPanel>
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasActiveProgress, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock x:Name="JobProgressText" Text="{Binding ProgressText}" Style="{StaticResource HelperText}"/>
                                            <ProgressBar x:Name="JobProgressBar" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                         automation:AutomationProperties.Name="Transcription job progress"
                                                         automation:AutomationProperties.ItemStatus="{Binding ProgressAccessibilityState}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Error}" Style="{StaticResource HelperText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="CaptureDock" Grid.Row="2" Padding="24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                automation:AutomationProperties.Name="Persistent recording controls">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="New meeting" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource HelperText}"
                                   automation:AutomationProperties.LiveSetting="Assertive"/>
                    </StackPanel>
                    <TextBlock x:Name="DurationText" Grid.Column="1" Text="{Binding CapturedDuration}"
                               FontFamily="Consolas" FontSize="26" Margin="12,0,20,0" VerticalAlignment="Center"/>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Content="Start recording" Command="{Binding StartCommand}"
                                Click="StartButton_Click"
                                IsEnabled="{Binding InitializationCompleted}"
                                Style="{StaticResource PrimaryButton}" Margin="0"
                                Visibility="{Binding IsIdle, Converter={StaticResource VisibleWhen}}"/>
                        <Button x:Name="PauseButton" Content="Pause" Command="{Binding PauseCommand}"
                                Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhen}}"/>
                        <Button x:Name="ResumeButton" Content="Resume" Command="{Binding ResumeCommand}"
                                Visibility="{Binding IsPaused, Converter={StaticResource VisibleWhen}}"/>
                        <Button x:Name="StopButton" Content="Stop" Command="{Binding StopCommand}" Margin="0"
                                Visibility="{Binding HasCapture, Converter={StaticResource VisibleWhen}}"/>
                    </WrapPanel>
                </Grid>
                <Expander x:Name="RecordingSetupExpander" Header="Recording setup and permission"
                          IsExpanded="{Binding RecordingSetupExpanded}"
                          automation:AutomationProperties.Name="Recording setup and permission">
                    <ScrollViewer x:Name="ContentScroll" MaxHeight="210" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,16,8,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <Label Target="{Binding ElementName=SourceCombo}" Content="Audio source"/>
                                    <ComboBox x:Name="SourceCombo" ItemsSource="{Binding AudioSources}" DisplayMemberPath="DisplayName"
                                              KeyboardNavigation.TabIndex="0"
                                              SelectedValuePath="Value" SelectedValue="{Binding AudioSource}"
                                              automation:AutomationProperties.Name="Audio source"/>
                                    <Label Target="{Binding ElementName=TitleBox}" Content="Optional recording title" Margin="0,12,0,0"/>
                                    <TextBox x:Name="TitleBox" Text="{Binding Title}" KeyboardNavigation.TabIndex="3"
                                             automation:AutomationProperties.Name="Optional recording title"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <Label Target="{Binding ElementName=MicrophoneCombo}" Content="Microphone"/>
                                    <ComboBox x:Name="MicrophoneCombo" ItemsSource="{Binding Microphones}" DisplayMemberPath="Name"
                                              KeyboardNavigation.TabIndex="1"
                                              SelectedValuePath="Id" SelectedValue="{Binding SelectedMicrophoneId}"
                                              IsEnabled="{Binding UsesMicrophone}" automation:AutomationProperties.Name="Microphone"/>
                                    <Label Target="{Binding ElementName=PlaybackCombo}" Content="Playback device" Margin="0,12,0,0"/>
                                    <ComboBox x:Name="PlaybackCombo" ItemsSource="{Binding PlaybackDevices}" DisplayMemberPath="Name"
                                              KeyboardNavigation.TabIndex="4"
                                              SelectedValuePath="Id" SelectedValue="{Binding SelectedPlaybackDeviceId}"
                                              IsEnabled="{Binding UsesPlayback}" automation:AutomationProperties.Name="Playback device"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Target="{Binding ElementName=LanguageCombo}" Content="Spoken language"/>
                                    <ComboBox x:Name="LanguageCombo" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                                              KeyboardNavigation.TabIndex="2"
                                              automation:AutomationProperties.Name="Spoken language"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="SystemAudioScopeText" Text="{Binding SystemAudioExplanation}"
                                       Style="{StaticResource HelperText}" Margin="0,12,0,0"/>
                            <Label Target="{Binding ElementName=DestinationBox}" Content="Local destination" Margin="0,16,0,0"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Choose..." Click="ChooseDestination_Click"
                                        KeyboardNavigation.TabIndex="6" Margin="8,0,0,0"/>
                                <TextBox x:Name="DestinationBox" Text="{Binding DestinationFolder}" KeyboardNavigation.TabIndex="5"
                                         automation:AutomationProperties.Name="Local destination folder"/>
                            </DockPanel>
                            <CheckBox x:Name="PermissionCheckBox" IsChecked="{Binding PermissionConfirmed}" IsEnabled="{Binding IsIdle}"
                                      KeyboardNavigation.TabIndex="7"
                                      Margin="0,16,0,8" automation:AutomationProperties.Name="Permission to record confirmed">
                                <TextBlock TextWrapping="Wrap" Text="I have permission to record every person whose audio may be captured."/>
                            </CheckBox>
                            <TextBlock Style="{StaticResource HelperText}" Text="This confirmation is not a guarantee of legal compliance."/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Microphone level" Style="{StaticResource HelperText}"/>
                                    <ProgressBar x:Name="MicrophoneLevel" Minimum="0" Maximum="1" Height="6" Value="{Binding MicrophoneLevel}"
                                                 automation:AutomationProperties.Name="Microphone audio level"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="System level" Style="{StaticResource HelperText}"/>
                                    <ProgressBar x:Name="SystemLevel" Minimum="0" Maximum="1" Height="6" Value="{Binding SystemAudioLevel}"
                                                 automation:AutomationProperties.Name="System audio level"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Padding="24,8" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap"
                       automation:AutomationProperties.LiveSetting="Assertive"/>
        </Border>
    </Grid>
</Window>
