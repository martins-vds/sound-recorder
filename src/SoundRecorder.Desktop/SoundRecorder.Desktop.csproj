<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="SkipCompilerExecution">

  <ItemGroup>
    <ProjectReference Include="..\SoundRecorder.Core\SoundRecorder.Core.csproj" />
    <ProjectReference Include="..\SoundRecorder.Infrastructure\SoundRecorder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_TargetAssemblyProjectName)' != ''">
    <!-- WPF type inspection needs compiled local types, without regenerating the parent's XAML sources. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <SkipCompilerExecution>false</SkipCompilerExecution>
  </PropertyGroup>

</Project>
